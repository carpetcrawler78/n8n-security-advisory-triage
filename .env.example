# Copy to .env and set your own values. Never commit .env.
# Nach .env kopieren und eigene Werte setzen. .env nie committen.
POSTGRES_DB=advisory
POSTGRES_USER=advisory
POSTGRES_PASSWORD=change-me

# Shared secret between n8n and the task runners (any random string).
# Gemeinsames Geheimnis zwischen n8n und den Task-Runnern (beliebige Zufallszeichenkette).
N8N_RUNNERS_AUTH_TOKEN=change-me-too

# Groq API key, only used by scripts/setup-n8n to create the credential.
# Groq-API-Key, wird nur von scripts/setup-n8n zum Anlegen der Zugangsdaten benutzt.
GROQ_API_KEY=

# Tested version; n8n and runners always use the same tag.
# Getestete Version; n8n und Runner nutzen immer denselben Tag.
# N8N_VERSION=2.42.7
